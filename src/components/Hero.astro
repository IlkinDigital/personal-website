---
import portrait from '../assets/ilkin.JPG';

const status = 'building walfeed for students in azerbaijan';
---

<section class="hero">
  <div class="hero-grid">
    <h1 class="hero-title">
      <span class="line"><span data-hero-line>hello, i'm</span></span>
      <span class="line"><em data-hero-line>ilkin mammadli</em></span>
    </h1>

    <figure class="portrait" data-portrait tabindex="0">
      <div class="portrait-frame">
        <img
          src={portrait.src}
          width={portrait.width}
          height={portrait.height}
          alt="Ilkin Mammadli"
          fetchpriority="high"
          decoding="async"
          data-portrait-img
        />
      </div>

      <!-- Stays in the DOM rather than display:none, so it is still announced. -->
      <figcaption class="thought" data-thought>
        <span class="thought-body" data-thought-body>
          <span class="thought-key">currently</span>
          {status}
        </span>
        <span class="thought-dot dot-1" data-thought-dot></span>
        <span class="thought-dot dot-2" data-thought-dot></span>
        <span class="thought-dot dot-3" data-thought-dot></span>
      </figcaption>
    </figure>

    <p class="hero-bio" data-hero-fade>
      engineer, designer, builder. senior at georgia tech, focused on
      immersive technology and generative ai.
    </p>

    <a href="/about" class="hero-cta" data-magnetic data-hero-fade>
      <span class="cta-label">more about me</span>
      <span class="cta-icon">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Shorter than a full viewport: the section no longer has to be scrolled
       past before any real content appears. */
    min-height: 84dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 5vh, 3.25rem);
    padding: calc(var(--nav-clear) + clamp(1.5rem, 5vh, 3rem)) var(--gutter) clamp(2.5rem, 6vh, 4rem);
    overflow: hidden;
  }

  /* Thought balloon: hidden until the portrait is hovered or focused. */
  .thought {
    position: absolute;
    bottom: 100%;
    right: 46%;
    margin-bottom: 2.75rem;
    width: max-content;
    max-width: 17rem;
    /* Cancel the portrait's tilt so the text sits level. */
    rotate: 2.5deg;
    pointer-events: none;
    z-index: 3;
  }

  .thought-body {
    display: block;
    padding: 0.85rem 1.15rem;
    border-radius: 20px;
    /* Grows from the corner the trail leads to, not from its middle. */
    transform-origin: bottom right;
    font-size: var(--step-micro);
    line-height: 1.55;
    color: var(--ink);
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      inset 0 0 0 1px var(--rule),
      0 14px 34px -10px rgb(0 0 0 / 0.4);
  }

  .thought-key {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  /* The trail runs from the balloon down toward the portrait. */
  .thought-dot {
    position: absolute;
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      inset 0 0 0 1px var(--rule),
      0 6px 14px -6px rgb(0 0 0 / 0.35);
  }

  .dot-1 { width: 13px; height: 13px; top: 100%; right: 16%; margin-top: 7px; }
  .dot-2 { width: 9px;  height: 9px;  top: 100%; right: 8%;  margin-top: 24px; }
  .dot-3 { width: 6px;  height: 6px;  top: 100%; right: 2%;  margin-top: 38px; }

  /* CSS transitions rather than a JS timeline: they retarget from the current
     value, so a fast in-and-out reverses smoothly instead of queueing. */
  :global(.js) .thought-body,
  :global(.js) .thought-dot {
    opacity: 0;
    transition:
      opacity 320ms var(--ease-out),
      transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(.js) .thought-body {
    transform: scale(0.88) translateY(8px);
    transition-delay: 150ms;
  }

  :global(.js) .thought-dot {
    transform: scale(0.4);
  }

  /* The trail forms from the face upward, so the smallest dot leads. */
  :global(.js) .dot-3 { transition-delay: 0ms; }
  :global(.js) .dot-2 { transition-delay: 60ms; }
  :global(.js) .dot-1 { transition-delay: 110ms; }

  :global(.js) .thought.is-open .thought-body,
  :global(.js) .thought.is-open .thought-dot {
    opacity: 1;
    transform: none;
  }

  /* Leaving is quicker than arriving, and all at once. */
  :global(.js) .thought:not(.is-open) .thought-body,
  :global(.js) .thought:not(.is-open) .thought-dot {
    transition-duration: 180ms;
    transition-delay: 0ms;
  }

  .portrait:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: var(--radius-card);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    column-gap: var(--gutter);
    row-gap: clamp(1.75rem, 4vh, 3rem);
  }

  .hero-title {
    grid-column: 1 / 8;
    grid-row: 1;
    font-size: clamp(3.25rem, 11vw, 9.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  /* Clipping box for the mask reveal. The padding is what stops `overflow:
     hidden` from shearing the ascenders off at this line-height. */
  .line {
    display: block;
    overflow: hidden;
    padding-top: 0.1em;
    margin-top: -0.1em;
  }

  .line > * {
    display: block;
    padding-bottom: 0.09em;
    margin-bottom: -0.03em;
  }

  .hero-title em {
    font-style: italic;
  }

  .portrait {
    position: relative;
    grid-column: 8 / 12;
    grid-row: 1 / span 2;
    align-self: center;
    rotate: -2.5deg;
  }

  .portrait-frame {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--paper-raised);
    box-shadow: 0 30px 80px color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    filter: grayscale(0) contrast(1);
    transition: filter 800ms var(--ease-out);
    will-change: transform;
  }

  @media (hover: hover) and (pointer: fine) {
    .portrait:hover img {
      filter: grayscale(0) contrast(1);
    }
  }

  .hero-bio {
    grid-column: 1 / 5;
    grid-row: 2;
    max-width: 32ch;
    color: var(--ink-muted);
    line-height: 1.75;
  }

  /* Sits away from the bio, filling the gap between text and portrait. */
  .hero-cta {
    grid-column: 5 / 8;
    grid-row: 2;
    justify-self: end;
    align-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 1.35rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    font-size: var(--step-micro);
    letter-spacing: 0.06em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 420ms var(--ease-out),
      color 420ms var(--ease-out),
      border-color 420ms var(--ease-out);
  }

  /* Button-in-button: the icon lives in its own circle. */
  .cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--ink) 9%, transparent);
    transition:
      transform 420ms var(--ease-out),
      background-color 420ms var(--ease-out);
  }

  .cta-icon svg {
    width: 14px;
    height: 14px;
  }

  .hero-cta:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-cta:hover {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--paper);
    }

    .hero-cta:hover .cta-icon {
      transform: translateX(3px);
      background: color-mix(in srgb, var(--paper) 22%, transparent);
    }
  }

  /* Entry states, applied only when JS can animate them away. */
  :global(.js) .line > * {
    transform: translateY(105%);
  }

  :global(.js) [data-hero-fade] {
    opacity: 0;
  }

  @media (max-width: 1024px) {
    .hero-title {
      grid-column: 1 / 9;
      font-size: clamp(3rem, 12vw, 6rem);
    }

    .portrait {
      grid-column: 9 / 13;
    }

    .hero-bio {
      grid-column: 1 / 6;
    }

    .hero-cta {
      grid-column: 6 / 9;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
      gap: 2rem;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      row-gap: 1.75rem;
    }

    .hero-title,
    .hero-bio,
    .hero-cta {
      grid-column: 1 / -1;
      grid-row: auto;
      justify-self: start;
    }

    .portrait {
      grid-column: 1 / -1;
      grid-row: auto;
      order: -1;
      width: min(72%, 18rem);
      margin: 0 auto;
      rotate: -2deg;
    }

    .portrait img {
      height: clamp(15rem, 34vh, 21rem);
    }
  }

  /* Keyed on width as well as hover: a narrow screen has no room for a floating
     balloon regardless of whether the device reports a hover-capable pointer. */
  @media (max-width: 760px), (hover: none) {
    .thought {
      position: static;
      rotate: 0deg;
      max-width: none;
      width: 100%;
      margin: 0.9rem 0 0;
    }

    .thought-dot {
      display: none;
    }

    :global(.js) .thought-body {
      opacity: 1;
      transform: none;
      transition-delay: 0ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .thought-body,
    :global(.js) .thought-dot {
      transform: none;
      transition-duration: 150ms;
      transition-delay: 0ms;
    }

    :global(.js) .line > * {
      transform: none;
    }

    :global(.js) [data-hero-fade] {
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  const thought = document.querySelector<HTMLElement>('[data-thought]');

  const lines = gsap.utils.toArray<HTMLElement>('[data-hero-line]');
  const fades = gsap.utils.toArray<HTMLElement>('[data-hero-fade]');
  const portrait = document.querySelector<HTMLElement>('[data-portrait]');
  const portraitImg = document.querySelector<HTMLElement>('[data-portrait-img]');

  // Thought balloon: a class toggle, with the motion owned by CSS above.
  if (portrait && thought) {
    const open = () => thought.classList.add('is-open');
    const close = () => thought.classList.remove('is-open');

    portrait.addEventListener('pointerenter', open);
    portrait.addEventListener('pointerleave', close);
    portrait.addEventListener('focus', open);
    portrait.addEventListener('blur', close);
  }

  if (reducedMotion()) {
    gsap.set(lines, { y: 0 });
    gsap.set(fades, { opacity: 1 });
  } else {
    const intro = gsap.timeline({ defaults: { ease: 'expo.out' } });

    intro.to(lines, { y: 0, duration: 1.4, stagger: 0.09 });

    if (portrait) {
      // fromTo, not from: explicit end values so the tween never depends on
      // GSAP inferring a "natural" value it may capture mid-render.
      intro.fromTo(
        portrait,
        { opacity: 0, scale: 1.06, y: 40 },
        { opacity: 1, scale: 1, y: 0, duration: 1.5 },
        0.25
      );
    }

    intro.to(fades, { opacity: 1, duration: 1, stagger: 0.12 }, 0.5);

    // Portrait drifts and settles as the hero scrolls away.
    if (portraitImg) {
      gsap.to(portraitImg, {
        yPercent: 14,
        scale: 1.12,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
    }
  }
</script>
