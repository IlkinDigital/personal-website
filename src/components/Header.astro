---
// Resume lives in the contact section on small screens, so it drops out of the
// nav there rather than competing for the limited width.
const navLinks = [
  { label: 'ABOUT', href: '/about', newTab: false, desktopOnly: false },
  { label: 'WORK', href: '/work', newTab: false, desktopOnly: false },
  { label: 'MEDIA', href: '/#media', newTab: false, desktopOnly: false },
  { label: 'RESUME', href: '/resume.pdf', newTab: true, desktopOnly: true },
  { label: 'CONTACT', href: '/#contact', newTab: false, desktopOnly: false },
];

// Homepage anchors and the PDF are destinations, not sections, so they never
// count as the current page.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href.startsWith('/#') || href.endsWith('.pdf')
    ? false
    : href === '/'
      ? path === '/'
      : path === href || path.startsWith(`${href}/`);
---

<header class="island" data-island>
  <!-- Specular highlight: light catching the material where the pointer is. -->
  <span class="sheen" data-sheen aria-hidden="true"></span>

  <!-- Selected state. Rests on the current tab, follows the pointer on hover. -->
  <span class="lozenge" data-lozenge aria-hidden="true"></span>

  <a href="/" class="wordmark" data-tab aria-current={isCurrent('/') ? 'page' : undefined}>
    <span class="wordmark-full">ilkin mammadli</span>
    <span class="wordmark-short">HOME </span>
  </a>

  <nav
    class="nav"
    aria-label="Primary"
    style={`--nav-count: ${navLinks.filter((l) => !l.desktopOnly).length}`}
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={['nav-link', { 'desktop-only': link.desktopOnly }]}
        data-tab
        aria-current={isCurrent(link.href) ? 'page' : undefined}
        target={link.newTab ? '_blank' : undefined}
        rel={link.newTab ? 'noopener noreferrer' : undefined}
      >
        <span>{link.label}</span>
      </a>
    ))}
  </nav>
</header>

<style>
  /* A web approximation of Apple's Liquid Glass. Apple documents that material
     for Apple platforms only; there is no official CSS for it. This is
     backdrop-filter plus layered edge lighting, not Apple's implementation. */
  .island {
    position: fixed;
    top: var(--nav-top);
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    isolation: isolate;
    overflow: hidden;

    width: min(calc(100% - 2rem), 1180px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--nav-h);
    padding: 0 0.6rem 0 0.5rem;
    border-radius: var(--radius-pill);

    /* The material: refract what is behind, lift its saturation and lightness. */
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--glass-tint) 76%, transparent),
        color-mix(in srgb, var(--glass-tint) 52%, transparent)
      );
    backdrop-filter: blur(26px) saturate(200%) brightness(var(--glass-bright));
    -webkit-backdrop-filter: blur(26px) saturate(200%) brightness(var(--glass-bright));

    /* Edge lighting: bright rim along the top, shadowed rim along the bottom,
       plus a soft drop shadow so the capsule reads as floating above content. */
    box-shadow:
      inset 0 1px 0 var(--glass-rim-top),
      inset 0 -1px 0 var(--glass-rim-bottom),
      inset 0 0 0 1px var(--glass-hairline),
      0 10px 30px -8px rgb(0 0 0 / 0.28),
      0 2px 8px -2px rgb(0 0 0 / 0.16);

    transition:
      box-shadow 500ms var(--ease-out),
      background-color 500ms var(--ease-out);
  }

  :root .island {
    --glass-tint: #ffffff;
    --glass-bright: 1.08;
    --glass-rim-top: rgb(255 255 255 / 0.85);
    --glass-rim-bottom: rgb(0 0 0 / 0.06);
    --glass-hairline: rgb(255 255 255 / 0.5);
    --sheen-color: rgb(255 255 255 / 0.55);
    --lozenge-fill: rgb(255 255 255 / 0.72);
  }

  @media (prefers-color-scheme: dark) {
    :root .island {
      --glass-tint: #2b2b2b;
      --glass-bright: 1.25;
      --glass-rim-top: rgb(255 255 255 / 0.28);
      --glass-rim-bottom: rgb(0 0 0 / 0.3);
      --glass-hairline: rgb(255 255 255 / 0.1);
      --sheen-color: rgb(255 255 255 / 0.16);
      --lozenge-fill: rgb(255 255 255 / 0.14);
    }
  }

  /* Deeper shadow once it floats over content, per material weight. */
  .island.is-lifted {
    box-shadow:
      inset 0 1px 0 var(--glass-rim-top),
      inset 0 -1px 0 var(--glass-rim-bottom),
      inset 0 0 0 1px var(--glass-hairline),
      0 18px 50px -10px rgb(0 0 0 / 0.42),
      0 4px 12px -2px rgb(0 0 0 / 0.22);
  }

  .sheen {
    position: absolute;
    top: 50%;
    left: 0;
    width: 240px;
    height: 240px;
    margin: -120px 0 0 -120px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    background: radial-gradient(circle closest-side, var(--sheen-color), transparent 70%);
    transition: opacity 600ms var(--ease-out);
    will-change: transform;
  }

  .island:hover .sheen {
    opacity: 1;
  }

  .wordmark,
  .nav {
    position: relative;
    z-index: 2;
  }

  .wordmark {
    /* Matches .nav-link padding so the lozenge has the same breathing room
       around this tab as it does around the others. */
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-style: italic;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: transform 140ms var(--ease-out);
  }

  .wordmark:active {
    transform: scale(0.96);
  }

  .wordmark-short {
    display: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-right: 0.4rem;
  }

  /* A single glass lozenge marks the current tab and slides on hover, rather
     than every item growing its own fill. */
  .lozenge {
    position: absolute;
    top: 50%;
    left: 0;
    height: 0;
    width: 0;
    z-index: 1;
    border-radius: var(--radius-pill);
    pointer-events: none;
    opacity: 0;
    background: var(--lozenge-fill);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      inset 0 0 0 1px rgb(255 255 255 / 0.14),
      0 2px 8px -2px rgb(0 0 0 / 0.2);
    will-change: transform, width;
  }

  /* Legible even before JS places the lozenge. */
  [aria-current='page'] {
    color: var(--ink);
  }

  .nav-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
    font-size: var(--step-micro);
    /* Vibrancy: slightly heavier and looser than body text so it stays legible
       against whatever is passing behind the glass. */
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 300ms var(--ease-out),
      transform 140ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--ink);
    }
  }

  /* Response lives on the press, not the release. */
  .nav-link:active {
    transform: scale(0.95);
  }

  @media (max-width: 860px) {
    .desktop-only {
      display: none;
    }

    .island {
      width: calc(100% - 1.5rem);
      gap: 0;
      padding: 0 0.4rem;
      justify-content: center;
    }

    .wordmark {
      flex: 1;
      display: flex;
      justify-content: center;
      font-family: var(--font-mono);
      font-style: normal;
      font-size: 0.75rem;
      letter-spacing: 0.01em;
      color: var(--ink-muted);
      padding: 0.45rem 0.2rem;
    }

    .wordmark-full {
      display: none;
    }

    .wordmark-short {
      display: inline;
    }

    .nav {
      gap: 0;
      margin-right: 0;
      /* One share per visible link, so wordmark + links all end up equal. */
      flex: var(--nav-count, 4);
    }

    .nav-link {
      flex: 1;
      justify-content: center;
      padding: 0.45rem 0.2rem;
      font-size: 0.75rem;
      letter-spacing: 0.01em;
    }
  }

  @media (max-width: 380px) {
    .island {
      padding: 0 0.2rem;
    }

    .wordmark,
    .nav-link {
      padding: 0.45rem 0.1rem;
      font-size: 0.68rem;
      letter-spacing: 0;
    }
  }

  /* Frosted glass is a preference, not a requirement. */
  @media (prefers-reduced-transparency: reduce) {
    .island {
      background: var(--paper);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border: 1px solid var(--rule-strong);
    }

    .sheen {
      display: none;
    }
  }

  @media (prefers-contrast: more) {
    .island {
      background: var(--paper);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border: 1px solid var(--ink);
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '../scripts/motion';

  const island = document.querySelector<HTMLElement>('[data-island]');
  const sheen = document.querySelector<HTMLElement>('[data-sheen]');
  const lozenge = document.querySelector<HTMLElement>('[data-lozenge]');
  const tabs = Array.from(document.querySelectorAll<HTMLElement>('[data-tab]'));
  const current = document.querySelector<HTMLElement>('[data-tab][aria-current="page"]');

  if (island) {
    ScrollTrigger.create({
      start: 'top -40',
      end: 99999,
      onToggle: (self) => island.classList.toggle('is-lifted', self.isActive),
    });
  }

  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (island && fine && !reducedMotion()) {
    // Specular highlight trails the pointer, so the surface reads as a material
    // catching light rather than a flat panel.
    if (sheen) {
      const sx = gsap.quickTo(sheen, 'x', { duration: 0.55, ease: 'power3.out' });
      const sy = gsap.quickTo(sheen, 'y', { duration: 0.55, ease: 'power3.out' });

      island.addEventListener('pointermove', (e) => {
        const r = island.getBoundingClientRect();
        sx(e.clientX - r.left);
        sy(e.clientY - r.top - r.height / 2);
      });
    }

  }

  // One lozenge marks the current tab and travels to whatever is hovered,
  // returning home on leave. Critically damped: a hover carries no momentum.
  if (island && lozenge && tabs.length) {
    // yPercent handles vertical centring, so the height can vary per tab.
    gsap.set(lozenge, { yPercent: -50 });

    const move = gsap.quickTo(lozenge, 'x', { duration: 0.42, ease: 'power3.out' });
    const grow = gsap.quickTo(lozenge, 'width', { duration: 0.42, ease: 'power3.out' });
    const tall = gsap.quickTo(lozenge, 'height', { duration: 0.42, ease: 'power3.out' });

    const placeOn = (tab: HTMLElement, animate: boolean) => {
      const ir = island.getBoundingClientRect();
      const r = tab.getBoundingClientRect();
      const x = r.left - ir.left;

      if (animate) {
        move(x);
        grow(r.width);
        tall(r.height);
      } else {
        gsap.set(lozenge, { x, width: r.width, height: r.height, yPercent: -50 });
      }
    };

    const settle = (animate: boolean) => {
      if (current) {
        placeOn(current, animate);
        gsap.to(lozenge, { opacity: 1, duration: 0.3, ease: 'power2.out' });
      } else {
        gsap.to(lozenge, { opacity: 0, duration: 0.3, ease: 'power2.out' });
      }
    };

    settle(false);

    if (fine && !reducedMotion()) {
      tabs.forEach((tab) => {
        tab.addEventListener('pointerenter', () => {
          // Materialise in place when arriving from nothing, otherwise slide.
          const visible = Number(gsap.getProperty(lozenge, 'opacity')) > 0.05;
          placeOn(tab, visible);
          gsap.to(lozenge, { opacity: 1, duration: 0.25, ease: 'power2.out' });
        });
      });

      island.addEventListener('pointerleave', () => settle(true));
    }

    // Widths change with the breakpoint, so re-measure rather than drift.
    window.addEventListener('resize', () => settle(false), { passive: true });
  }
</script>
