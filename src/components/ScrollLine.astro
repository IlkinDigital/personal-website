---
// Persistent scroll line component that appears on all pages
---

<div class="deco-line">
  <div class="scroll-dot"></div>
</div>

<style is:global>
  .deco-line {
    position: fixed;
    left: 2rem;
    top: 10rem;
    width: 1px;
    height: calc(100vh - 14rem);
    background: #888;
    z-index: 50;
    mix-blend-mode: difference;
  }

  .scroll-dot {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    background: #fff;
    border-radius: 50%;
    transition: top 0.15s ease-out;
    animation: sparkle 2s ease-in-out infinite;
  }

  .scroll-dot::before {
    content: '';
    position: absolute;
    inset: -4px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.8) 0%, transparent 70%);
    border-radius: 50%;
    animation: sparkle-glow 2s ease-in-out infinite;
  }

  .scroll-dot::after {
    content: '';
    position: absolute;
    inset: -8px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 60%);
    border-radius: 50%;
    animation: sparkle-pulse 1.5s ease-in-out infinite alternate;
  }

  @keyframes sparkle {
    0%, 100% {
      box-shadow: 
        0 0 4px 1px rgba(255, 255, 255, 0.8),
        0 0 8px 2px rgba(255, 255, 255, 0.4);
      transform: translateX(-50%) scale(1);
    }
    50% {
      box-shadow: 
        0 0 8px 2px rgba(255, 255, 255, 1),
        0 0 16px 4px rgba(255, 255, 255, 0.6),
        0 0 24px 6px rgba(255, 255, 255, 0.2);
      transform: translateX(-50%) scale(1.1);
    }
  }

  @keyframes sparkle-glow {
    0%, 100% {
      opacity: 0.6;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.3);
    }
  }

  @keyframes sparkle-pulse {
    0% {
      opacity: 0.2;
      transform: scale(0.8);
    }
    100% {
      opacity: 0.5;
      transform: scale(1.2);
    }
  }

  @media (max-width: 768px) {
    .deco-line {
      display: none;
    }
  }
</style>

<script>
  const scrollDot = document.querySelector('.scroll-dot') as HTMLElement;
  const decoLine = document.querySelector('.deco-line') as HTMLElement;

  function updateScrollDot() {
    if (!scrollDot || !decoLine) return;

    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const scrollPercent = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
    
    const lineHeight = decoLine.offsetHeight - scrollDot.offsetHeight;
    const dotPosition = scrollPercent * lineHeight;
    
    scrollDot.style.top = `${dotPosition}px`;
  }

  window.addEventListener('scroll', updateScrollDot, { passive: true });
  window.addEventListener('resize', updateScrollDot);
  document.addEventListener('DOMContentLoaded', updateScrollDot);
  updateScrollDot();
</script>

