---
import mediaData from '../data/media.json';

const mediaItems = mediaData.mediaItems;
---

<section class="media" id="media">
  <div class="media-container">
    <div class="media-header">
      <h2 class="media-title">media & talks</h2>
      <div class="media-line"></div>
    </div>

    <div class="media-list">
      {mediaItems.map((item, index) => (
        <a href={item.link} class="media-item" target="_blank"
        rel="noopener noreferrer" style={`--delay: ${index * 0.1}s`}>
          <div class="media-item-content">
            <span class="media-type">{item.type}</span>
            <h3 class="media-item-title">{item.title}</h3>
          </div>
          <div class="media-item-meta">
            <span class="media-date">{item.date}</span>
            <span class="media-arrow">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .media {
    padding: 6rem 3rem;
    background: var(--color-bg);
    position: relative;
  }

  .media-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .media-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .media-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0;
    white-space: nowrap;
  }

  .media-line {
    flex: 1;
    height: 1px;
    background: var(--color-text);
    opacity: 0.2;
  }

  .media-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .media-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  .media-item:first-child {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .media-item:hover {
    padding-left: 1rem;
    background: rgba(0, 0, 0, 0.02);
  }

  .media-item:hover .media-arrow {
    transform: translateX(5px);
  }

  .media-item-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .media-type {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
  }

  .media-item-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    margin: 0;
  }

  .media-item-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .media-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .media-arrow {
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }

  @media (max-width: 768px) {
    .media {
      padding: 4rem 1.5rem;
    }

    .media-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .media-item-meta {
      width: 100%;
      justify-content: space-between;
    }

    .media-title {
      font-size: 1.5rem;
    }

    .media-item-title {
      font-size: 1rem;
    }
  }
</style>

