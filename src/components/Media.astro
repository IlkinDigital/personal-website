---
import mediaData from '../data/media.json';

const items = mediaData.mediaItems.map((item) => {
  const [format, language] = item.type.split('|').map((part) => part.trim());
  return { ...item, format, language };
});
---

<section class="media" id="media">
  <div class="section-head" data-reveal>
    <h2>media &amp; talks</h2>
    <span class="rule"></span>
    <span class="count">press</span>
  </div>

  <div class="entries">
    {items.map((item, i) => (
      <a
        href={item.link}
        class="entry"
        target="_blank"
        rel="noopener noreferrer"
        data-entry
      >
        <span class="entry-index" data-entry-index>{String(i + 1).padStart(2, '0')}</span>

        <span class="entry-main" data-reveal>
          <span class="entry-meta">
            <span>{item.format}</span>
            <span class="entry-lang">{item.language}</span>
            <span class="entry-date">{item.date}</span>
          </span>

          <span class="entry-title">{item.title}</span>

          <span class="entry-go">
            read
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12L12 4M6 4h6v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .media {
    padding: var(--section-y) var(--gutter);
    overflow-x: clip;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: clamp(2.25rem, 4vw, 3.25rem);
    max-width: 1180px;
    margin: 0 auto;
  }

  .entry {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 5vw, 4rem);
    text-decoration: none;
  }

  /* Oversized numeral drifts against the text as you scroll. */
  .entry-index {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--accent);
    opacity: 0.5;
    font-variant-numeric: tabular-nums;
    will-change: transform;
    transition: opacity 500ms var(--ease-out), color 500ms var(--ease-out);
  }

  .entry-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
    transition: border-color 400ms var(--ease-out);
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: var(--step-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .entry-lang {
    color: var(--ink-muted);
  }

  .entry-date {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .entry-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.85rem);
    line-height: 1.22;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .entry-go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-micro);
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    transition: color 300ms var(--ease-out);
  }

  .entry-go svg {
    width: 13px;
    height: 13px;
    transition: transform 380ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .entry:hover .entry-index {
      opacity: 1;
      color: var(--accent);
    }

    .entry:hover .entry-main {
      border-color: var(--ink);
    }

    .entry:hover .entry-go {
      color: var(--ink);
    }

    .entry:hover .entry-go svg {
      transform: translate(3px, -3px);
    }
  }

  @media (max-width: 720px) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .entry-meta {
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .entry-date {
      margin-left: 0;
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  if (!reducedMotion()) {
    gsap.utils.toArray<HTMLElement>('[data-entry]').forEach((entry) => {
      const index = entry.querySelector<HTMLElement>('[data-entry-index]');
      if (!index) return;

      gsap.fromTo(
        index,
        { yPercent: 28 },
        {
          yPercent: -28,
          ease: 'none',
          scrollTrigger: {
            trigger: entry,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        }
      );
    });
  }
</script>
