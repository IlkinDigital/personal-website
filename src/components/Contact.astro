---
const email = 'ilkin@gatech.edu';

const elsewhere = [
  { label: 'resume', href: '/resume.pdf' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/ilkinmammadli/' },
  { label: 'github', href: 'https://github.com/IlkinDigital' },
];

const year = new Date().getFullYear();
---

<section class="contact" id="contact">
  <h2 class="contact-title" data-contact-title>
    <span class="line"><span data-contact-line>let's build </span></span>
    <span class="line"><em data-contact-line>something</em></span>
    <span class="line"><span data-contact-line>together.</span></span>
  </h2>

  <span class="bottom-rule" aria-hidden="true"></span>

  <a href={`mailto:${email}`} class="contact-email" data-magnetic data-reveal>{email}</a>

  <ul class="elsewhere" data-reveal>
      {elsewhere.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12L12 4M6 4h6v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </li>
    ))}
  </ul>

  <footer class="colophon">
    <span>&copy; {year} ilkin mammadli</span>
    <span>atlanta, georgia</span>
  </footer>
</section>

<style>
  /* One grid for the whole section, so the links can sit in the gaps the
     scattered heading leaves rather than in a footer row of their own. */
  .contact {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-content: center;
    column-gap: var(--gutter);
    row-gap: clamp(1rem, 2.5vh, 1.75rem);
    min-height: 65vh;
    padding: clamp(2.25rem, 6vh, 3.5rem) var(--gutter) clamp(1.5rem, 4vw, 2.25rem);
  }

  .contact-title {
    grid-column: 1 / -1;
    grid-row: 1;
    /* Bigger, but with leading tightened to match, so the block height holds.
       Large display type wants tight leading and negative tracking. */
    font-size: clamp(3rem, 10.5vw, 9.5rem);
    line-height: 0.86;
    letter-spacing: -0.052em;
    font-weight: 450;
    font-optical-sizing: auto;
  }

  /* Corner-thrown: the middle line is pushed to the opposite side, leaving a
     deliberate void on the middle-left. Only the heading is offset. */
  .line:nth-child(1) { margin-left: 5%; }
  .line:nth-child(2) { margin-left: 52%; margin-bottom: 0.1em }
  .line:nth-child(3) { margin-left: 24%; }

  .line {
    display: block;
    overflow: hidden;
    /* At 0.86 leading the glyphs exceed the line box, so the clip needs
       headroom. Cancelled by the negative margin, so rhythm is unchanged. */
    padding-top: 0.2em;
    margin-top: -0.2em;
  }

  /* inline-block so the box hugs the words: the scatter is only readable if
     each line occupies its text, not the full column width. */
  .line > * {
    display: inline-block;
    padding-bottom: 0.1em;
    margin-bottom: -0.04em;
  }

  .contact-title em {
    font-style: italic;
  }

  :global(.js) .line > * {
    transform: translateY(105%);
  }

  .elsewhere {
    grid-column: 7 / -1;
    grid-row: 2;
    /* Clears the divider above; the links were crossing it. */
    margin-top: clamp(1.5rem, 2.8vh, 2rem);
    align-self: baseline;
    justify-self: end;
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .elsewhere a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step-micro);
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 260ms var(--ease-out);
  }

  .elsewhere svg {
    width: 12px;
    height: 12px;
    transition: transform 380ms var(--ease-out);
  }

  .contact-email {
    grid-column: 1 / 7;
    grid-row: 2;
    position: relative;
    margin-top: clamp(1.25rem, 2.4vh, 1.75rem);
    justify-self: start;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.5vw, 2.5rem);
    font-style: italic;
    letter-spacing: -0.02em;
    text-decoration: none;
    padding-bottom: 0.1em;
  }

  .contact-email::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 520ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-email:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .elsewhere a:hover {
      color: var(--ink);
    }

    .elsewhere a:hover svg {
      transform: translate(3px, -3px);
    }
  }

  .bottom-rule {
    grid-column: 1 / -1;
    grid-row: 2;
    align-self: start;
    height: 1px;
    /* Clears the descenders of the last line; -1.5rem cut through them. */
    margin-top: 0.35rem;
    background: var(--rule);
  }

  .colophon {
    grid-column: 1 / -1;
    grid-row: 3;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(1.25rem, 3vh, 2.25rem);
    font-size: var(--step-micro);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  @media (max-width: 1200px) {
    .line:nth-child(1) { margin-left: 14%; }
    .line:nth-child(2) { margin-left: 42%; }
    .line:nth-child(3) { margin-left: 24%; }
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
      /* Spacing is set per item below so each row can carry its own air. */
      row-gap: 0;
      padding-block: clamp(2rem, 7vh, 3rem) clamp(1.5rem, 5vh, 2rem);
    }

    /* The heading has the full width to itself here, so it can run larger than
       the desktop floor and leave less of the screen empty. */
    .contact-title {
      grid-column: 1 / -1;
      grid-row: 1;
      font-size: clamp(2.35rem, 12vw, 4.5rem);
    }

    /* The same corner-throw as the desktop, but softer: the lines run about
       half the column here, so the desktop's 45% put "something" hard against
       the right gutter. At 30% the diagonal still reads and the longest line
       stops around 82% of the measure, clear of the edge. */
    .line:nth-child(1) { margin-left: 0; }
    .line:nth-child(2) { margin-left: 30%; }
    .line:nth-child(3) { margin-left: 13%; }

    /* The email leaves the heading's cell on mobile. Overlaid there it sat on
       the middle line's baseline in the same italic display face, so it read
       as a fourth word in the sentence rather than as the one thing in this
       section to tap. Below the rule it is unambiguously an action, and it can
       carry a real tap target. */
    .contact-email {
      grid-column: 1 / -1;
      grid-row: 3;
      justify-self: start;
      margin-top: clamp(1.25rem, 3.5vh, 1.75rem);
      font-size: clamp(1.5rem, 7vw, 2.1rem);
      line-height: 1.1;
    }

    /* Kept on mobile, unlike before: with the email below the heading instead
       of inside it, this hairline is what separates the two. */
    .bottom-rule {
      grid-row: 2;
      margin-top: clamp(1.75rem, 4.5vh, 2.5rem);
    }

    .elsewhere {
      grid-column: 1 / -1;
      grid-row: 4;
      flex-wrap: wrap;
      gap: 0.25rem 1.75rem;
      margin-top: clamp(0.75rem, 2.5vh, 1.25rem);
      justify-self: start;
    }

    /* 44px of height on a 12px label: the padding is the tap target, and the
       reduced margins above and below keep the rhythm unchanged. */
    .elsewhere a {
      min-height: 44px;
    }

    /* Grows the email's hit area past its glyphs without moving anything: the
       box still hugs the text, so the underline stays on the baseline. */
    .contact-email::before {
      content: '';
      position: absolute;
      inset: -0.65rem -0.5rem;
    }

    .colophon {
      grid-column: 1 / -1;
      grid-row: 5;
      margin-top: clamp(1rem, 3vh, 1.5rem);
    }
  }

  /* Without hover there is no way to discover the underline, so on touch the
     email carries it permanently — it is a link standing in a block of type. */
  @media (hover: none) {
    .contact-email::after {
      transform: scaleX(1);
      opacity: 0.45;
    }

    /* Touch has no hover to confirm with, so the press itself has to answer. */
    .contact-email:active,
    .elsewhere a:active {
      transform: scale(0.98);
    }

    .contact-email,
    .elsewhere a {
      transition: transform 160ms var(--ease-out), color 260ms var(--ease-out);
    }
  }

  @media (max-width: 640px) {
    .colophon {
      flex-direction: column;
      gap: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .line > * {
      transform: none;
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  const title = document.querySelector<HTMLElement>('[data-contact-title]');
  const lines = gsap.utils.toArray<HTMLElement>('[data-contact-line]');

  if (title && lines.length) {
    if (reducedMotion()) {
      gsap.set(lines, { y: 0 });
    } else {
      gsap.to(lines, {
        y: 0,
        duration: 1.3,
        ease: 'expo.out',
        stagger: 0.1,
        scrollTrigger: { trigger: title, start: 'top 78%', once: true },
      });
    }
  }

  // Magnetic pull on the email and hero CTA.
  if (!reducedMotion() && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      const xTo = gsap.quickTo(el, 'x', { duration: 0.6, ease: 'power3.out' });
      const yTo = gsap.quickTo(el, 'y', { duration: 0.6, ease: 'power3.out' });

      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        xTo((e.clientX - (r.left + r.width / 2)) * 0.22);
        yTo((e.clientY - (r.top + r.height / 2)) * 0.4);
      });

      el.addEventListener('pointerleave', () => {
        xTo(0);
        yTo(0);
      });
    });
  }
</script>
