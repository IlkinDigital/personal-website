---
import projectsData from '../data/projects.json';

const allProjects = projectsData.projects;
// The homepage shows a curated few; the rest live in the archive.
const projects = allProjects.slice(0, 4);
const count = String(allProjects.length).padStart(2, '0');

// Hand-placed so the column runs read as composed rather than arbitrary.
// Negative pull interleaves a card with the one above it.
const placements = [
  { col: '2 / 6',  rot: -1.8, pull: '0' },
  { col: '8 / 11', rot: 1.5,  pull: '-11vh' },
  { col: '4 / 8',  rot: -1.1, pull: '-3vh' },
  { col: '9 / 12', rot: 1.9,  pull: '-13vh' },
];
---

<section class="work" id="work">
  <div class="section-head" data-reveal>
    <h2>selected work</h2>
    <span class="rule"></span>
    <span class="count">{count} projects</span>
  </div>

  <div class="scatter" data-scatter>
    {projects.map((project, i) => (
      <article
        class="card"
        style={`grid-column: ${placements[i % placements.length].col}; --rot: ${placements[i % placements.length].rot}deg; --pull: ${placements[i % placements.length].pull};`}
        data-card
        data-reveal
      >
        <a href={project.link} class="card-link" target="_blank" rel="noopener noreferrer">
          <span class="card-media">
            <img src={project.image} alt={`${project.title} preview`} loading="lazy" decoding="async" />
          </span>

          <span class="card-body">
            <span class="card-meta">
              <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="card-year">{project.year}</span>
            </span>

            <h3 class="card-title">{project.title}</h3>

            <span class="card-foot">
              <span class="card-tags">{project.tags.slice(0, 3).join(', ')}</span>
              <span class="card-go">
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M4 12L12 4M6 4h6v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
          </span>
        </a>
      </article>
    ))}
  </div>

  <a href="/work" class="archive-link" data-reveal>full archive</a>
</section>

<style>
  .work {
    padding: var(--section-y) var(--gutter) 0;
  }

  .scatter {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Each card sits in its own column run, tilted, and pulled up to overlap the
     one above so the section reads as a collage rather than a list. */
  .card {
    margin-top: var(--pull, 0);
    rotate: var(--rot, 0deg);
    will-change: transform;
  }

  .card-link {
    display: block;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    box-shadow: 0 24px 70px color-mix(in srgb, var(--ink) 16%, transparent);
    text-decoration: none;
  }

  .card-media {
    display: block;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--paper);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(0.9rem, 1.6vw, 1.25rem);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: var(--step-micro);
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .card-index {
    color: var(--accent);
    font-weight: 500;
  }

  .card-title {
    font-size: clamp(1.15rem, 1.9vw, 1.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--step-micro);
    color: var(--ink-muted);
  }

  .card-go {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    transition:
      transform 420ms var(--ease-out),
      background-color 420ms var(--ease-out),
      color 420ms var(--ease-out);
  }

  .card-go svg {
    width: 15px;
    height: 15px;
  }

  @media (hover: hover) and (pointer: fine) {
    .card-link:hover .card-media img {
      transform: scale(1.04);
    }

    .card-link:hover .card-go {
      background: var(--accent);
      color: var(--paper);
      transform: translate(2px, -2px);
    }
  }

  .archive-link {
    display: inline-block;
    margin-top: clamp(2rem, 5vw, 3rem);
    font-size: var(--step-micro);
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
    padding-bottom: 0.3rem;
    transition:
      color 200ms var(--ease-out),
      border-color 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .archive-link:hover {
      color: var(--ink);
      border-color: var(--ink);
    }
  }

  @media (max-width: 900px) {
    .scatter {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1rem, 3vw, 1.5rem);
      row-gap: clamp(1.5rem, 4vw, 2.5rem);
    }

    .card {
      grid-column: auto !important;
      margin-top: 0;
      rotate: 0deg;
    }
  }

  @media (max-width: 560px) {
    .scatter {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  const cards = gsap.utils.toArray<HTMLElement>('[data-card]');

  // Cards drift at different rates as they pass, so the collage reads with
  // depth instead of moving as one flat sheet. CSS owns the resting tilt.
  if (cards.length && !reducedMotion()) {
    cards.forEach((card, i) => {
      const drift = [7, -5, 3, -8, 5, -4, 6][i % 7];

      gsap.fromTo(
        card,
        { yPercent: drift },
        {
          yPercent: -drift,
          ease: 'none',
          scrollTrigger: {
            trigger: card,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 0.6,
          },
        }
      );
    });
  }
</script>
