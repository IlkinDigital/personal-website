---
import ScrollLine from '../components/ScrollLine.astro';

interface Props {
  title?: string;
}

const { title = "ILKIN MAMMADLI" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body>
    <ScrollLine />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #ffffff;
    --color-bg-dark: #0a0a0a;
    --color-text: #0a0a0a;
    --color-text-light: #f5f5f5;
    --color-muted: #666666;
    --font-display: 'Syne', sans-serif;
    --font-serif: 'Instrument Serif', serif;
    --font-mono: 'DM Mono', monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-mono);
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::selection {
    background: var(--color-text);
    color: var(--color-bg);
  }
</style>
