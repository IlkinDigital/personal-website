---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import projectsData from '../data/projects.json';

const projects = projectsData.projects;
// First tag is the discipline; the rest are tools and stay as per-project metadata.
const categories = ['all', ...new Set(projects.map((p) => p.tags[0]))];
---

<Layout
  title="Work by Ilkin Mammadli"
  description="Projects across immersive technology, graphics, web and community organizing."
>
  <Header />

  <main class="work-page" id="main">
    <header class="work-intro">
      <h1>selected work</h1>
      <p>a collection of projects spanning tech and art.</p>
    </header>

    <section class="filters" aria-label="Filter projects by discipline">
      {categories.map((cat, i) => (
        <button
          class="filter-btn"
          data-category={cat}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {cat}
        </button>
      ))}
    </section>

    <section class="gallery" aria-live="polite">
      <div class="gallery-grid">
        {projects.map((project, i) => (
          <a
            href={project.link}
            class="tile"
            data-discipline={project.tags[0]}
            style={`--ar: ${['4 / 3', '1 / 1', '4 / 5'][i % 3]}`}
            target="_blank"
            rel="noopener noreferrer"
            data-reveal
          >
            <span class="tile-frame">
              <img src={project.image} alt={`${project.title} preview`} loading="lazy" decoding="async" />
            </span>

            <span class="tile-meta">
              <span class="tile-tags">{project.tags.join(', ')}</span>
              <span class="tile-year">{project.year}</span>
            </span>

            <h2 class="tile-title">{project.title}</h2>
            <p class="tile-desc">{project.description}</p>
          </a>
        ))}
      </div>

      <p class="gallery-empty" hidden>
        nothing filed under that discipline yet. try another filter.
      </p>
    </section>

    <footer class="work-footer">
      <a href="/" class="back-link">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        back to home
      </a>
    </footer>
  </main>
</Layout>

<style>
  .work-page {
    padding-top: var(--nav-clear);
    overflow-x: clip;
  }

  .work-intro {
    padding: clamp(4rem, 12vh, 7rem) var(--gutter) clamp(2rem, 5vw, 3rem);
  }

  .work-intro h1 {
    font-size: var(--step-display);
    font-style: italic;
    line-height: 1.02;
    letter-spacing: -0.035em;
    padding-bottom: 0.08em;
  }

  .work-intro p {
    margin-top: 1.25rem;
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 var(--gutter) 2rem;
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    letter-spacing: 0.06em;
    padding: 0.5rem 1rem;
    color: var(--ink-muted);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      background-color 200ms var(--ease-out),
      border-color 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }

  .filter-btn:active {
    transform: scale(0.97);
  }

  .filter-btn[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  @media (hover: hover) and (pointer: fine) {
    .filter-btn:hover:not([aria-pressed='true']) {
      color: var(--ink);
      border-color: var(--rule-strong);
    }
  }

  .gallery {
    padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) 0;
    border-top: 1px solid var(--rule);
  }

  /* Three across, but tiles carry different proportions so the grid reads as a
     gallery rather than a row of identical cards. */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    column-gap: clamp(1.25rem, 2.5vw, 2.25rem);
    row-gap: clamp(2.5rem, 4.5vw, 3.5rem);
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
  }

  .tile[hidden] {
    display: none;
  }

  .tile-frame {
    display: block;
    aspect-ratio: var(--ar, 4 / 3);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--paper-raised);
    margin-bottom: 0.5rem;
  }

  .tile-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .tile-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--step-micro);
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .tile-year {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tile-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.6vw, 1.45rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .tile-desc {
    color: var(--ink-muted);
    font-size: var(--step-micro);
    line-height: 1.7;
    max-width: 46ch;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .tile:hover .tile-frame img {
      transform: scale(1.03);
    }
  }

  .gallery-empty {
    padding: clamp(3rem, 8vw, 5rem) 0;
    color: var(--ink-muted);
    text-align: center;
  }

  .work-footer {
    margin-top: clamp(5rem, 12vw, 8rem);
    padding: clamp(2.5rem, 6vw, 4rem) var(--gutter);
    border-top: 1px solid var(--rule);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-micro);
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 200ms var(--ease-out);
  }

  .back-link svg {
    width: 14px;
    height: 14px;
    transition: transform 260ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .back-link:hover {
      color: var(--ink);
    }

    .back-link:hover svg {
      transform: translateX(-3px);
    }
  }

  @media (max-width: 1080px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .gallery-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '../scripts/motion';

  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('.tile'));
  const empty = document.querySelector<HTMLElement>('.gallery-empty');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

      const category = btn.dataset.category;
      const shown = tiles.filter((tile) => {
        const match = category === 'all' || tile.dataset.discipline === category;
        tile.hidden = !match;
        return match;
      });

      if (empty) empty.hidden = shown.length > 0;

      // A tile revealed below the fold has no pending trigger left, so drive the
      // filtered set directly and re-measure the triggers the hiding displaced.
      if (reducedMotion()) {
        gsap.set(shown, { opacity: 1, y: 0, filter: 'none' });
      } else {
        gsap.fromTo(
          shown,
          { opacity: 0, y: 18, filter: 'blur(6px)' },
          { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.75, ease: 'expo.out', stagger: 0.05 }
        );
      }

      ScrollTrigger.refresh();
    });
  });
</script>
